# === BACKEND ===
# "vllm" = lokalny serwer vLLM (domyślnie)
# "openai" = prawdziwe OpenAI API
BACKEND=vllm

# === vLLM (gdy BACKEND=vllm) ===
VLLM_BASE_URL=http://127.0.0.1:8000/v1
MODEL_NAME=speakleash/Bielik-4.5B-v3.0-Instruct
# MODEL_NAME=speakleash/Bielik-11B-v2.6-Instruct

# vLLM nie wymaga klucza, ale SDK wymaga niepustej wartości
OPENAI_API_KEY=EMPTY

# === OpenAI API (gdy BACKEND=openai) ===
# BACKEND=openai
# OPENAI_API_KEY=sk-...
# MODEL_NAME=gpt-4o-mini
# MODEL_NAME=gpt-4o

# === FastAPI ===
API_HOST=0.0.0.0
API_PORT=8080
